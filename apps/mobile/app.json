{
  "expo": {
    "name": "Chanchito",
    "slug": "chanchito",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chanchito",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.agustinnarla.chanchito",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#f1fded",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0c160d"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
