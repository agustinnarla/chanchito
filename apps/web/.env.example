# Copiar a .env.local (ignorado por git) y completar con los datos del proyecto de Supabase:
# Project Settings → API (o Data API / API Keys).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave pública: "publishable" (sb_publishable_...) o la "anon" legacy. Es segura en el
# frontend porque los datos se protegen con RLS. NUNCA usar acá la service_role / secret key.
VITE_SUPABASE_ANON_KEY=
